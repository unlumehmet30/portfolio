{$SITE_HOST} {
  encode zstd gzip
  header {
    -Server
    -Via
    -X-Powered-By
    defer
  }

  @api path /api /api/*
  handle @api {
    reverse_proxy backend:8080 {
      header_down -Server
      header_down -Via
      header_down -X-Powered-By
    }
  }

  handle {
    reverse_proxy frontend:3001 {
      header_down -Server
      header_down -Via
      header_down -X-Powered-By
    }
  }
}
