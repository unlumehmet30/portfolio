# Use the Droplet public IPv4 address without a protocol in SITE_HOST.
SITE_HOST="YOUR_PUBLIC_IP.sslip.io"
CORS_ORIGIN="https://YOUR_PUBLIC_IP.sslip.io"
NEXT_PUBLIC_API_URL="https://YOUR_PUBLIC_IP.sslip.io/api"
NEXT_PUBLIC_SITE_URL="https://YOUR_PUBLIC_IP.sslip.io"
TRUST_PROXY=true
UPLOADS_DIR="uploads"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"

# Leave these empty to keep contact messages only in the admin panel.
CONTACT_NOTIFICATION_EMAIL=""
CONTACT_EMAIL_FROM="Mehmet Portfolio <onboarding@resend.dev>"
RESEND_API_KEY=""
